{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
  {{- $robots := lower (string .Params.robots) }}
  {{- if and (not (strings.Contains $robots "noindex")) (ne .Kind "taxonomy") (ne .Kind "term") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- with .Lastmod }}
    <lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
